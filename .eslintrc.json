{
  "env": {
    "node": true,
    "commonjs": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-throw-literal": "error",
    "no-return-await": "error",
    "require-await": "error",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "multi-line"],
    "no-duplicate-imports": "error",
    "no-shadow": "warn"
  },
  "ignorePatterns": ["dist/", "node_modules/", "data/", "profile/"]
}
